    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "shadcn": "^4.21.4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "husky": "^9.1.0",
    "lint-staged": "^15.2.0",
    "postcss": "^8",
    "prettier": "^3.3.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^2.0.0",
    "storybook": "^10.6.1",
    "@storybook/react-webpack5": "^10.6.1",
    "@storybook/addon-webpack5-compiler-swc": "latest",
    "@storybook/addon-a11y": "^10.6.1",

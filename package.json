{
  "name": "@utm-dev-labs/puntoflor",
  "version": "0.1.0",
  "private": true,
  "description": "PuntoFlor — Sistema de gestion integral para florerias",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,css}\"",
